using Microsoft.EntityFrameworkCore;
using StudentApi.Data;
using StudentApi.Models;
using System.Collections.Generic;
using System.Linq;

namespace StudentApi.Services
{
    public class DepartmentService : IDepartmentService
    {
        private readonly ApplicationDbContext _context;

        public DepartmentService(ApplicationDbContext context)
        {
            _context = context;
        }

        public IEnumerable<Department> GetAll()
        {
            return _context.Departments.AsNoTracking().ToList();
        }

        public Department? GetById(int id)
        {
            return _context.Departments.Find(id);
        }

        public Department Create(Department department)
        {
            _context.Departments.Add(department);
            _context.SaveChanges();
            return department;
        }

        public Department? Update(int id, Department department)
        {
            var existing = _context.Departments.Find(id);
            if (existing == null) return null;
            existing.Name = department.Name;
            _context.SaveChanges();
            return existing;
        }

        public bool Delete(int id)
        {
            var existing = _context.Departments.Find(id);
            if (existing == null) return false;
            _context.Departments.Remove(existing);
            _context.SaveChanges();
            return true;
        }

        public IEnumerable<DepartmentStatisticsDto> GetStatistics()
        {
            var stats = _context.Departments
                .Select(d => new DepartmentStatisticsDto
                {
                    DepartmentName = d.Name,
                    NumberOfStudents = d.Students.Count,
                    AverageAge = d.Students.Any() ? d.Students.Average(s => s.Age) : 0,
                    OldestAge = d.Students.Any() ? d.Students.Max(s => s.Age) : 0,
                    YoungestAge = d.Students.Any() ? d.Students.Min(s => s.Age) : 0
                })
                .ToList();

            return stats;
        }

        public HighestLowestDto GetHighestLowest()
        {
            var stats = GetStatistics().ToList();
            if (!stats.Any()) return new HighestLowestDto();

            var max = stats.Max(s => s.NumberOfStudents);
            var min = stats.Min(s => s.NumberOfStudents);

            return new HighestLowestDto
            {
                DepartmentWithHighestStudents = string.Join(", ", stats.Where(s => s.NumberOfStudents == max).Select(s => s.DepartmentName)),
                DepartmentWithLowestStudents = string.Join(", ", stats.Where(s => s.NumberOfStudents == min).Select(s => s.DepartmentName))
            };
        }
    }
}
